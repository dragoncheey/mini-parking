page {
  min-height: 100%;
  background: #f2f4f3;
  color: #17201e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: 0;
  overflow-x: hidden;
}

view,
text,
button,
input,
textarea,
picker,
slider {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 6px;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.muted {
  color: #74807c;
}

.strong {
  font-weight: 700;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #49615b;
  background: #edf2ef;
  font-size: 22rpx;
  white-space: nowrap;
}

.primary-button,
.secondary-button,
.ghost-button,
.danger-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  min-height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}

.primary-button {
  color: #ffffff;
  background: #1a7f64;
  box-shadow: 0 10rpx 24rpx rgba(23, 107, 91, 0.18);
}

.secondary-button {
  color: #145347;
  background: #dff1eb;
}

.ghost-button {
  color: #42524e;
  background: #edf0ed;
}

.danger-button {
  color: #8a3a12;
  background: #fff0e5;
}

.empty {
  margin-top: 32rpx;
  padding: 40rpx 28rpx;
  border: 1rpx solid #e2e7e3;
  border-radius: 24rpx;
  background: #ffffff;
  color: #74807c;
  font-size: 28rpx;
  line-height: 1.6;
}
