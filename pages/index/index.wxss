page {
  height: 100%;
  overflow: hidden;
  background: #f2f4f3;
}

.home {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.is-pressed {
  opacity: 0.72;
}

/* ---------- 顶部 ---------- */
.home-header {
  flex-shrink: 0;
  padding: 12rpx 28rpx 18rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(23, 32, 30, 0.05);
  position: relative;
  z-index: 3;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.destination-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f2f5f4;
}

.destination-dot {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin-right: 20rpx;
  border: 6rpx solid #1a7f64;
  border-radius: 50%;
  background: #ffffff;
}

.destination-dot.is-empty {
  border-color: #b5bfbb;
}

.destination-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.destination-label {
  font-size: 22rpx;
  color: #8a9692;
  line-height: 1.3;
}

.destination-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #17201e;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.destination-change {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a7f64;
}

.avatar-button {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #e8eeec;
  color: #49615b;
  font-size: 28rpx;
  font-weight: 700;
}

.avatar-button.is-signed-in {
  background: #1a7f64;
  color: #ffffff;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.duration-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.duration-label {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #4b5a56;
}

.duration-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.duration-chips {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 8rpx;
}

.duration-chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f2f5f4;
  color: #3c4a46;
  font-size: 26rpx;
  white-space: nowrap;
}

.duration-chip.is-active {
  background: #1a7f64;
  color: #ffffff;
  font-weight: 700;
}

.duration-chip.is-custom:not(.is-active) {
  border: 1rpx dashed #b5c4bf;
  background: #ffffff;
}

.vehicle-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #8a9692;
}

.vehicle-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vehicle-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #1a7f64;
  font-weight: 600;
}

/* ---------- 地图 ---------- */
.map-wrap {
  flex-shrink: 0;
  position: relative;
  height: 400rpx;
  transition: height 0.22s ease;
}

.map-wrap.is-tall {
  height: 760rpx;
}

.home-map {
  width: 100%;
  height: 100%;
}

.map-share {
  position: absolute;
  left: 24rpx;
  bottom: 48rpx;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 30, 0.16);
  color: #17201e;
  font-size: 25rpx;
  font-weight: 600;
}

.map-share-plus {
  margin-right: 8rpx;
  color: #1a7f64;
  font-size: 32rpx;
  font-weight: 700;
}

.map-tools {
  position: absolute;
  right: 24rpx;
  bottom: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.map-tool {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 30, 0.16);
}

.map-tool-icon {
  font-size: 34rpx;
  color: #3c4a46;
  font-weight: 700;
  line-height: 1;
}

.locate-icon {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #1a7f64;
  border-radius: 50%;
}

.locate-icon-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1a7f64;
}

/* ---------- 列表 ---------- */
.result-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: -28rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #f2f4f3;
  position: relative;
  z-index: 2;
}

.result-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}

.sort-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #e4e9e7;
}

.sort-tab {
  height: 56rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  color: #5d6b67;
  font-size: 25rpx;
}

.sort-tab.is-active {
  background: #ffffff;
  color: #17201e;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 30, 0.08);
}

.scope-button {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #4b5a56;
  font-size: 25rpx;
}

.scope-button.is-active {
  background: #e2f2ec;
  color: #1a7f64;
  font-weight: 700;
}

.scope-caret {
  margin-left: 6rpx;
  font-size: 20rpx;
}

.result-summary {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 32rpx 6rpx;
  font-size: 23rpx;
  color: #8a9692;
}

.summary-strong {
  color: #17201e;
  font-weight: 700;
}

.summary-cheapest {
  color: #e2561f;
  font-weight: 600;
}

.result-scroll {
  flex: 1;
  min-height: 0;
}

.result-list {
  padding: 12rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.lot-card {
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(23, 32, 30, 0.04);
}

.lot-card.is-selected {
  border-color: #1a7f64;
  box-shadow: 0 8rpx 28rpx rgba(26, 127, 100, 0.16);
}

.lot-top {
  display: flex;
  align-items: flex-start;
}

.lot-rank {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eef2f0;
  color: #5d6b67;
  font-size: 24rpx;
  font-weight: 700;
}

.lot-rank.is-best {
  background: #1a7f64;
  color: #ffffff;
}

.lot-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.lot-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #17201e;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lot-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7c8985;
  line-height: 1.4;
}

.lot-price {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.lot-fee {
  font-size: 38rpx;
  font-weight: 800;
  color: #e2561f;
  line-height: 1.2;
  white-space: nowrap;
}

.lot-fee.is-free {
  color: #1a7f64;
}

.lot-fee-note {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5a1;
  white-space: nowrap;
}

.lot-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-left: 62rpx;
}

.lot-tags {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.lot-tag {
  height: 40rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 10rpx;
  background: #e2f2ec;
  color: #1a7f64;
  font-size: 21rpx;
}

.lot-tag.is-warn {
  background: #fff1e6;
  color: #b4521c;
}

.lot-trust {
  font-size: 21rpx;
  color: #9aa5a1;
}

.nav-button {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 60rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #1a7f64;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.load-more-line {
  padding: 16rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a3ada9;
}

/* 骨架屏 */
.lot-card.is-skeleton {
  height: 150rpx;
}

.skeleton-line {
  width: 46%;
  height: 26rpx;
  margin-bottom: 22rpx;
  border-radius: 8rpx;
  background: #eef2f0;
}

.skeleton-line.is-wide {
  width: 72%;
  height: 32rpx;
}

/* 空状态 */
.empty-state {
  margin-top: 12rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201e;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #7c8985;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.empty-button {
  height: 72rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #eef2f0;
  color: #3c4a46;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-button.is-primary {
  background: #1a7f64;
  color: #ffffff;
}
