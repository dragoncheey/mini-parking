.index-page {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  background: #e8eeeb;
}

.map-background {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1;
  width: 100%;
}

.map-top-actions,
.map-search-bar {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 18rpx);
  left: 28rpx;
  right: 28rpx;
  z-index: 4;
}

.map-top-actions {
  display: flex;
  pointer-events: none;
}

.map-account-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 260rpx;
  min-height: 68rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border: 1rpx solid rgba(222, 230, 225, 0.96);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 32rpx rgba(31, 47, 43, 0.14);
  pointer-events: auto;
}

.account-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  overflow: hidden;
  border-radius: 50%;
  color: #ffffff;
  background: #176b5b;
  font-size: 22rpx;
  font-weight: 800;
}

.account-avatar-image {
  width: 100%;
  height: 100%;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-status,
.account-action {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-status {
  color: #17201e;
  font-size: 23rpx;
  font-weight: 800;
}

.account-action {
  margin-top: 3rpx;
  color: #7a8682;
  font-size: 18rpx;
}

.account-chevron {
  color: #89948f;
  font-size: 30rpx;
  line-height: 1;
}

.map-add-float {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 18rpx);
  right: 32rpx;
  z-index: 4;
}

.map-add-action,
.map-round-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(222, 230, 225, 0.96);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(31, 47, 43, 0.14);
}

.map-add-action-hover,
.locate-control-hover {
  opacity: 0.9;
  transform: scale(0.96);
}

.map-add-plus {
  color: #176b5b;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.map-search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.map-back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 80rpx;
  color: #17201e;
  font-size: 58rpx;
}

.search-shell {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dfe6e1;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12rpx 32rpx rgba(31, 47, 43, 0.14);
}

.search-prefix {
  margin-right: 12rpx;
  color: #176b5b;
  font-size: 36rpx;
  font-weight: 900;
}

.map-search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  color: #17201e;
  font-size: 28rpx;
}

.map-more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  color: #77837f;
  font-size: 30rpx;
}

.map-action-stack {
  position: absolute;
  right: 32rpx;
  z-index: 4;
  display: grid;
  gap: 16rpx;
}

.map-round-button {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.map-mini-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.mini-corner,
.mini-axis,
.mini-ring,
.mini-dot {
  position: absolute;
}

.mini-corner {
  width: 11rpx;
  height: 11rpx;
  border-color: #26332f;
  border-style: solid;
}

.mini-corner-tl { top: 2rpx; left: 2rpx; border-width: 3rpx 0 0 3rpx; }
.mini-corner-tr { top: 2rpx; right: 2rpx; border-width: 3rpx 3rpx 0 0; }
.mini-corner-bl { bottom: 2rpx; left: 2rpx; border-width: 0 0 3rpx 3rpx; }
.mini-corner-br { right: 2rpx; bottom: 2rpx; border-width: 0 3rpx 3rpx 0; }

.mini-axis {
  left: 50%;
  top: 50%;
  background: #26332f;
  transform: translate(-50%, -50%);
}

.mini-axis-x { width: 27rpx; height: 3rpx; }
.mini-axis-y { width: 3rpx; height: 27rpx; }

.mini-ring {
  top: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  left: 7rpx;
  border: 3rpx solid #26332f;
  border-radius: 50%;
}

.mini-dot {
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #26332f;
  transform: translate(-50%, -50%);
}

.bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  min-height: 220px;
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
  background: #f6f7f4;
  box-shadow: 0 -14rpx 46rpx rgba(31, 47, 43, 0.15);
}

.bottom-sheet.is-animating {
  transition: height 220ms ease, transform 220ms ease;
}

.sheet-plan-card {
  position: relative;
  z-index: 3;
  flex: 0 0 auto;
  padding: 14rpx 28rpx 16rpx;
}

.sheet-drag-zone {
  padding-top: 2rpx;
}

.sheet-grabber {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: #ced6d1;
}

.sheet-summary-row,
.sheet-title-line,
.map-mode-summary,
.filter-toolbar,
.list-header,
.lot-main,
.metric-row,
.source-line,
.action-row {
  display: flex;
  align-items: center;
}

.sheet-summary-row {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 84rpx;
}

.sheet-summary-main {
  flex: 1;
  min-width: 0;
}

.sheet-title-line {
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-eyebrow,
.sheet-caret {
  color: #7b8783;
  font-size: 20rpx;
}

.sheet-eyebrow {
  font-weight: 800;
  letter-spacing: 2rpx;
}

.sheet-caret {
  flex: 0 0 auto;
}

.sheet-title {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  color: #17201e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-count-box {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  color: #176b5b;
  background: #e2f1eb;
}

.sheet-count-number {
  font-size: 30rpx;
  font-weight: 900;
}

.sheet-count-label {
  font-size: 20rpx;
  font-weight: 700;
}

.map-mode-summary {
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
}

.map-mode-summary > view {
  flex: 1;
  min-width: 0;
}

.map-mode-title,
.map-mode-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-mode-title {
  color: #17201e;
  font-size: 29rpx;
  font-weight: 900;
}

.map-mode-meta {
  margin-top: 6rpx;
  color: #77837f;
  font-size: 22rpx;
}

.map-mode-expand {
  flex: 0 0 auto;
  color: #176b5b;
  font-size: 24rpx;
  font-weight: 800;
}

.quick-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.workbench-config-row {
  margin-top: 10rpx;
}

.quick-summary-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 82rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #e0e6e2;
  border-radius: 18rpx;
  background: #ffffff;
}

.quick-summary-item.is-active {
  border-color: #84b9aa;
  background: #edf7f3;
}

.quick-icon {
  flex: 0 0 auto;
  color: #176b5b;
  font-size: 28rpx;
  font-weight: 900;
}

.car-icon {
  font-size: 22rpx;
}

.quick-copy {
  flex: 1;
  min-width: 0;
}

.quick-label,
.quick-value {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-label {
  color: #87918e;
  font-size: 18rpx;
}

.quick-value {
  margin-top: 3rpx;
  color: #25302d;
  font-size: 22rpx;
  font-weight: 800;
}

.duration-quick-panel {
  position: absolute;
  top: 196rpx;
  left: 28rpx;
  right: 28rpx;
  z-index: 8;
  padding: 22rpx;
  border: 1rpx solid #dce6e1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(31, 47, 43, 0.18);
}

.duration-menu-title {
  display: block;
  color: #27332f;
  font-size: 25rpx;
  font-weight: 900;
}

.duration-option-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.duration-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  border-radius: 16rpx;
  color: #52605c;
  background: #f0f3f0;
  font-size: 22rpx;
  font-weight: 700;
}

.duration-option.is-selected {
  color: #ffffff;
  background: #176b5b;
}

.duration-custom-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 16rpx 4rpx 0;
  border-top: 1rpx solid #edf0ed;
  color: #176b5b;
  font-size: 23rpx;
  font-weight: 800;
}

.filter-toolbar {
  position: relative;
  z-index: 6;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.scope-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.scope-row {
  display: inline-flex;
  gap: 8rpx;
}

.scope-chip,
.sort-compact-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #66736f;
  background: #e9edea;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.scope-chip.is-active {
  color: #ffffff;
  background: #253b35;
}

.recommendation-sort {
  position: relative;
  flex: 0 0 auto;
}

.sort-compact-trigger {
  gap: 9rpx;
  color: #176b5b;
  background: #e2f1eb;
}

.sort-chevron {
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg) translateY(-2rpx);
}

.sort-compact-trigger.is-open .sort-chevron {
  transform: rotate(225deg);
}

.recommendation-sort-menu {
  position: absolute;
  top: 64rpx;
  right: 0;
  z-index: 12;
  width: 260rpx;
  padding: 10rpx;
  border: 1rpx solid #e0e6e2;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(31, 47, 43, 0.18);
}

.recommendation-sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 66rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  color: #5f6b67;
  font-size: 23rpx;
}

.recommendation-sort-option.is-active {
  color: #176b5b;
  background: #edf7f3;
  font-weight: 900;
}

.sort-check {
  font-weight: 900;
}

.first-recommendation-preview {
  display: grid;
  grid-template-columns: 66rpx minmax(0, 1fr) 132rpx;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dce5e0;
  border-radius: 22rpx;
  background: #ffffff;
}

.preview-rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 48rpx;
  border-radius: 14rpx;
  color: #176b5b;
  background: #e2f1eb;
  font-size: 20rpx;
  font-weight: 900;
}

.preview-main {
  min-width: 0;
}

.preview-name,
.preview-meta,
.preview-fee,
.preview-note {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-name {
  color: #202a27;
  font-size: 26rpx;
  font-weight: 900;
}

.preview-meta {
  margin-top: 6rpx;
  color: #7b8682;
  font-size: 20rpx;
}

.preview-price {
  text-align: right;
}

.preview-fee {
  color: #d06b35;
  font-size: 29rpx;
  font-weight: 900;
}

.preview-note {
  margin-top: 5rpx;
  color: #176b5b;
  font-size: 19rpx;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
}

.sheet-content {
  padding: 4rpx 28rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

.list-header {
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 2rpx 20rpx;
}

.list-kicker,
.list-title {
  display: block;
}

.list-kicker {
  color: #176b5b;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.list-title {
  margin-top: 4rpx;
  color: #17201e;
  font-size: 32rpx;
  font-weight: 900;
}

.list-count {
  color: #7b8783;
  font-size: 22rpx;
}

.lot-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e0e6e2;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(31, 47, 43, 0.05);
}

.lot-card.is-best {
  border-color: #9ecabd;
  box-shadow: 0 10rpx 30rpx rgba(23, 107, 91, 0.1);
}

.lot-main {
  align-items: flex-start;
  gap: 14rpx;
}

.rank-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 15rpx;
  color: #ffffff;
  background: #263b35;
  font-size: 23rpx;
  font-weight: 900;
}

.lot-info {
  flex: 1;
  min-width: 0;
}

.lot-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9rpx;
}

.lot-name {
  color: #17201e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.best-label {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  color: #176b5b;
  background: #dff1eb;
  font-size: 18rpx;
  font-weight: 900;
}

.lot-address {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: #7a8581;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-box {
  flex: 0 0 116rpx;
  text-align: right;
}

.price,
.price-note {
  display: block;
}

.price {
  color: #d06b35;
  font-size: 33rpx;
  font-weight: 900;
}

.price-note {
  margin-top: 6rpx;
  color: #929b98;
  font-size: 18rpx;
}

.metric-row {
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.metric-item {
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  color: #5b6965;
  background: #f0f3f0;
  font-size: 20rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.source-line {
  gap: 9rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0ed;
}

.source-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  overflow: hidden;
  border-radius: 50%;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
}

.source-avatar-image {
  width: 100%;
  height: 100%;
}

.source-name,
.source-confidence {
  color: #78837f;
  font-size: 20rpx;
}

.source-name {
  color: #42504c;
  font-weight: 800;
}

.action-row {
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-button {
  flex: 1;
  min-width: 0;
  min-height: 70rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.sheet-empty {
  margin-top: 10rpx;
}

.load-more-line {
  padding: 10rpx 0 30rpx;
  color: #84908c;
  font-size: 22rpx;
  text-align: center;
}

.load-more-line.is-end {
  color: #a0a8a5;
}

.is-map-mode:not(.is-sheet-expanded) .bottom-sheet {
  border-radius: 28rpx 28rpx 0 0;
}

.is-map-mode.is-sheet-expanded .map-search-bar {
  display: none;
}
