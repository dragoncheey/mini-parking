<view class="home">
  <!-- 顶部：目的地 + 停车时长 -->
  <view class="home-header">
    <view class="search-row">
      <view class="destination-box" bindtap="chooseDestination" hover-class="is-pressed">
        <view class="destination-dot {{hasDestination ? '' : 'is-empty'}}"></view>
        <view class="destination-copy">
          <text class="destination-label">{{locating ? '正在定位…' : '停车目的地'}}</text>
          <text class="destination-name">{{destinationName}}</text>
        </view>
        <text class="destination-change">更换</text>
      </view>
      <view class="avatar-button {{isLoggedIn ? 'is-signed-in' : ''}}" bindtap="goProfile" hover-class="is-pressed" aria-role="button" aria-label="我的">
        <image wx:if="{{userAvatarUrl}}" class="avatar-image" src="{{userAvatarUrl}}" mode="aspectFill" />
        <text wx:else>{{userAvatarText}}</text>
      </view>
    </view>

    <view class="duration-row">
      <text class="duration-label">停多久</text>
      <scroll-view class="duration-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="duration-chips">
          <view
            wx:for="{{durationQuickOptions}}"
            wx:key="value"
            class="duration-chip {{item.value === durationMinutes ? 'is-active' : ''}}"
            data-minutes="{{item.value}}"
            bindtap="selectDurationPreset"
          >{{item.label}}</view>
          <picker mode="multiSelector" range="{{durationPickerRanges}}" range-key="label" value="{{durationPickerValue}}" bindchange="onDurationNativeChange">
            <view class="duration-chip is-custom {{isCustomDuration ? 'is-active' : ''}}">{{isCustomDuration ? durationText : '自定义'}}</view>
          </picker>
        </view>
      </scroll-view>
    </view>

    <view class="vehicle-line" bindtap="goVehicles">
      <text class="vehicle-text">{{currentVehicle ? '按 ' + currentVehicleText + ' 计费' : '未设置车辆，按停车场默认规则计费'}}</text>
      <text class="vehicle-action">{{currentVehicle ? '切换' : '添加车辆'}} ›</text>
    </view>
  </view>

  <!-- 地图 -->
  <view class="map-wrap {{mapTall ? 'is-tall' : ''}}">
    <map
      class="home-map"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      scale="{{mapScale}}"
      markers="{{mapMarkers}}"
      include-points="{{mapPoints}}"
      show-location="{{hasLocation}}"
      bindmarkertap="onMarkerTap"
      bindcallouttap="onMarkerTap"
    ></map>

    <view class="map-share" bindtap="goAdd" hover-class="is-pressed" aria-role="button" aria-label="分享停车场">
      <text class="map-share-plus">＋</text>
      <text>分享停车场</text>
    </view>

    <view class="map-tools">
      <view class="map-tool" bindtap="toggleMapSize" hover-class="is-pressed" aria-role="button" aria-label="{{mapTall ? '缩小地图' : '放大地图'}}">
        <text class="map-tool-icon">{{mapTall ? '⌃' : '⌄'}}</text>
      </view>
      <view class="map-tool" bindtap="useCurrentLocationAsDestination" hover-class="is-pressed" aria-role="button" aria-label="定位到当前位置">
        <view class="locate-icon"><view class="locate-icon-dot"></view></view>
      </view>
    </view>
  </view>

  <!-- 结果列表 -->
  <view class="result-panel">
    <view class="result-toolbar">
      <view class="sort-tabs">
        <view
          wx:for="{{recommendationSortOptions}}"
          wx:key="value"
          class="sort-tab {{item.value === recommendationSortMode ? 'is-active' : ''}}"
          data-mode="{{item.value}}"
          bindtap="setRecommendationSortMode"
        >{{item.label}}</view>
      </view>
      <view class="scope-button {{parkingScope !== 'all' ? 'is-active' : ''}}" bindtap="chooseParkingScope">
        <text>{{parkingScopeText}}</text>
        <text class="scope-caret">▾</text>
      </view>
    </view>

    <view wx:if="{{hasRecommendations}}" class="result-summary">
      <text>3 公里内 <text class="summary-strong">{{recommendations.length}}</text> 个停车场 · 停 {{durationText}}</text>
      <text wx:if="{{cheapestFeeText}}" class="summary-cheapest">最低 {{cheapestFeeText}}</text>
    </view>

    <scroll-view
      class="result-scroll"
      scroll-y="{{true}}"
      scroll-into-view="{{scrollIntoId}}"
      scroll-with-animation="{{true}}"
      lower-threshold="120"
      refresher-enabled="{{hasDestination}}"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onListRefresh"
      bindscrolltolower="loadMoreRecommendations"
    >
      <view class="result-list">
        <block wx:if="{{loading && !hasRecommendations}}">
          <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="lot-card is-skeleton">
            <view class="skeleton-line is-wide"></view>
            <view class="skeleton-line"></view>
          </view>
        </block>

        <block wx:elif="{{hasRecommendations}}">
          <view
            wx:for="{{visibleRecommendations}}"
            wx:key="id"
            id="lot-{{item.id}}"
            class="lot-card {{item.id === selectedLotId ? 'is-selected' : ''}}"
            data-id="{{item.id}}"
            bindtap="goDetail"
            hover-class="is-pressed"
            hover-stay-time="80"
          >
            <view class="lot-top">
              <view class="lot-rank {{item.isBest ? 'is-best' : ''}}">{{item.isBest ? '荐' : item.rank}}</view>
              <view class="lot-info">
                <text class="lot-name">{{item.name}}</text>
                <text class="lot-meta">{{item.parkingTypeText}} · 距目的地 {{item.distanceText}} · 步行 {{item.walkingMinutes}} 分钟</text>
              </view>
              <view class="lot-price">
                <text class="lot-fee {{item.fee === 0 ? 'is-free' : ''}}">{{item.feeText}}</text>
                <text class="lot-fee-note">停 {{durationText}}</text>
              </view>
            </view>

            <view class="lot-bottom">
              <view class="lot-tags">
                <text
                  wx:for="{{item.tags}}"
                  wx:for-item="tag"
                  wx:key="*this"
                  class="lot-tag {{tag === '建议复核' ? 'is-warn' : ''}}"
                >{{tag}}</text>
                <text class="lot-trust">可信度 {{item.confidence}}</text>
              </view>
              <view class="nav-button" data-id="{{item.id}}" catchtap="openNavigation" hover-class="is-pressed">导航</view>
            </view>
          </view>
          <view class="load-more-line">{{hasMoreRecommendations ? '上滑加载更多' : '已经看完全部推荐'}}</view>
        </block>

        <view wx:else class="empty-state">
          <text class="empty-title">{{emptyTitle}}</text>
          <text class="empty-text">{{emptyText}}</text>
          <view class="empty-actions">
            <view class="empty-button is-primary" bindtap="chooseDestination">选择目的地</view>
            <view wx:if="{{hasDestination}}" class="empty-button" bindtap="goAdd">分享停车场</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
