<view class="page index-page {{mapExpanded ? 'is-map-mode' : ''}} {{sheetExpanded ? 'is-sheet-expanded' : ''}}">
  <map
    class="map-background"
    style="height: {{mapViewportHeightPx}}px;"
    latitude="{{mapLatitude}}"
    longitude="{{mapLongitude}}"
    scale="{{mapScale}}"
    markers="{{mapMarkers}}"
    include-points="{{mapPoints}}"
    show-location="{{hasLocation}}"
    enable-scroll="{{mapGestureEnabled}}"
    bindmarkertap="onMarkerTap"
  ></map>

  <view wx:if="{{!mapExpanded}}" class="map-top-actions">
    <view class="map-account-chip {{accountStatusClass}}" bindtap="goProfile">
      <view class="account-avatar">
        <image wx:if="{{userAvatarUrl}}" class="account-avatar-image" src="{{userAvatarUrl}}" mode="aspectFill" />
        <text wx:else>{{userAvatarText}}</text>
      </view>
      <view class="account-copy">
        <text class="account-status">{{accountStatusText}}</text>
        <text class="account-action">{{accountActionText}}</text>
      </view>
      <text class="account-chevron">›</text>
    </view>
  </view>

  <view wx:if="{{!mapExpanded}}" class="map-add-float">
    <view class="map-add-action" bindtap="goAdd" hover-class="map-add-action-hover" aria-role="button" aria-label="分享停车场">
      <text class="map-add-plus">＋</text>
    </view>
  </view>

  <view wx:if="{{mapExpanded}}" class="map-search-bar">
    <view class="map-back-button" bindtap="exitMapMode">‹</view>
    <view class="search-shell">
      <text class="search-prefix">⌕</text>
      <input
        class="map-search-input"
        value="{{mapSearchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        placeholder="搜索停车场"
      />
      <view wx:if="{{mapSearchKeyword}}" class="map-more-button" bindtap="clearSearch">×</view>
    </view>
  </view>

  <view class="map-action-stack" style="bottom: {{mapLocateBottomPx}}px;">
    <view wx:if="{{!mapExpanded}}" class="map-round-button expand-map-control" bindtap="enterMapMode" aria-role="button" aria-label="放大地图">
      <view class="map-mini-icon expand-mini-icon">
        <view class="mini-corner mini-corner-tl"></view>
        <view class="mini-corner mini-corner-tr"></view>
        <view class="mini-corner mini-corner-bl"></view>
        <view class="mini-corner mini-corner-br"></view>
      </view>
    </view>
    <view class="map-round-button locate-control" bindtap="useCurrentLocationAsDestination" hover-class="locate-control-hover" aria-role="button" aria-label="定位到当前位置">
      <view class="map-mini-icon locate-mini-icon">
        <view class="mini-axis mini-axis-x"></view>
        <view class="mini-axis mini-axis-y"></view>
        <view class="mini-ring"></view>
        <view class="mini-dot"></view>
      </view>
    </view>
  </view>

  <view
    class="bottom-sheet {{sheetExpanded ? 'is-expanded' : 'is-collapsed'}} {{sheetAnimating ? 'is-animating' : ''}}"
    style="height: {{sheetHeightPx}}px; transform: translateY({{sheetTranslateY}}px);"
    bindtouchstart="onSheetInteractionStart"
    bindtouchend="onSheetInteractionEnd"
    bindtouchcancel="onSheetInteractionEnd"
  >
    <view class="sheet-plan-card">
      <view
        class="sheet-drag-zone"
        bindtap="toggleSheet"
        catchtouchstart="onSheetTouchStart"
        catchtouchmove="onSheetTouchMove"
        catchtouchend="onSheetTouchEnd"
        catchtouchcancel="onSheetTouchCancel"
      >
        <view class="sheet-grabber"></view>
        <view wx:if="{{!mapExpanded}}" class="workbench-summary sheet-summary-row">
          <view class="sheet-summary-main">
            <view class="sheet-title-line">
              <text class="sheet-eyebrow">目的地</text>
              <text class="sheet-caret">{{sheetExpanded ? '收起地图卡片' : '展开全部推荐'}}</text>
            </view>
            <text class="sheet-title">{{destinationName}}</text>
          </view>
          <view class="sheet-count-box">
            <text class="sheet-count-number">{{recommendations.length}}</text>
            <text class="sheet-count-label">个推荐</text>
          </view>
        </view>
        <view wx:if="{{mapExpanded && !sheetExpanded}}" class="map-mode-summary">
          <view>
            <text class="map-mode-title">{{destinationName}}</text>
            <text class="map-mode-meta">{{recommendations.length}} 个停车场 · {{durationText}}</text>
          </view>
          <text class="map-mode-expand">查看列表</text>
        </view>
      </view>

      <block wx:if="{{!mapExpanded}}">
        <view class="workbench-config-row quick-summary-grid">
          <view class="quick-summary-item" bindtap="chooseDestination">
            <text class="quick-icon pin-icon">⌖</text>
            <view class="quick-copy">
              <text class="quick-label">目的地</text>
              <text class="quick-value">{{destinationName}}</text>
            </view>
          </view>
          <view class="quick-summary-item {{showDurationMenu ? 'is-active' : ''}}" bindtap="toggleDurationMenu">
            <text class="quick-icon">◷</text>
            <view class="quick-copy">
              <text class="quick-label">停车时长</text>
              <text class="quick-value">{{durationText}}</text>
            </view>
          </view>
          <view class="quick-summary-item" bindtap="goVehicles">
            <text class="quick-icon car-icon">▰</text>
            <view class="quick-copy">
              <text class="quick-label">当前车辆</text>
              <text class="quick-value">{{currentVehicleText}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{showDurationMenu}}" class="duration-quick-panel">
          <text class="duration-menu-title">预计停多久？</text>
          <view class="duration-option-row">
            <view
              wx:for="{{durationQuickOptions}}"
              wx:key="value"
              class="duration-option {{item.value === durationMinutes ? 'is-selected' : ''}}"
              data-minutes="{{item.value}}"
              bindtap="selectDurationPreset"
            >{{item.label}}</view>
          </view>
          <picker mode="multiSelector" range="{{durationPickerRanges}}" range-key="label" value="{{durationPickerValue}}" bindchange="onDurationNativeChange">
            <view class="duration-custom-action">精确设置天、小时和分钟 <text>›</text></view>
          </picker>
        </view>

        <view class="filter-toolbar">
          <scroll-view class="scope-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="scope-row">
              <view
                wx:for="{{parkingScopeOptions}}"
                wx:key="value"
                class="scope-chip {{item.value === parkingScope ? 'is-active' : ''}}"
                data-scope="{{item.value}}"
                bindtap="setParkingScope"
              >{{item.label}}</view>
            </view>
          </scroll-view>
          <view class="recommendation-sort">
            <view class="sort-compact-trigger {{sortDropdownOpen ? 'is-open' : ''}}" bindtap="toggleSortDropdown">
              <text>{{recommendationSortText}}</text>
              <text class="sort-chevron"></text>
            </view>
            <view wx:if="{{sortDropdownOpen}}" class="recommendation-sort-menu">
              <view
                wx:for="{{recommendationSortOptions}}"
                wx:key="value"
                class="recommendation-sort-option {{item.value === recommendationSortMode ? 'is-active' : ''}}"
                data-mode="{{item.value}}"
                bindtap="setRecommendationSortMode"
              >
                <text>{{item.label}}</text>
                <text class="sort-check">{{item.value === recommendationSortMode ? '✓' : ''}}</text>
              </view>
            </view>
          </view>
        </view>

        <block wx:if="{{!sheetExpanded && hasRecommendations && !showDurationMenu}}">
          <view wx:for="{{recommendations}}" wx:key="id" wx:if="{{index === 0}}" class="first-recommendation-preview" data-id="{{item.id}}" bindtap="goDetail">
            <view class="preview-rank">首选</view>
            <view class="preview-main">
              <text class="preview-name">{{item.name}}</text>
              <text class="preview-meta">{{item.distanceText}} · 步行 {{item.walkingMinutes}} 分钟</text>
            </view>
            <view class="preview-price">
              <text class="preview-fee">{{item.feeText}}</text>
              <text class="preview-note">查看详情 ›</text>
            </view>
          </view>
        </block>
      </block>
    </view>

    <scroll-view wx:if="{{sheetExpanded || !mapExpanded}}" class="sheet-scroll" scroll-y="{{sheetExpanded}}" lower-threshold="96" bindscrolltolower="loadMoreRecommendations">
      <view class="sheet-content">
        <view wx:if="{{sheetExpanded}}" class="list-header">
          <view>
            <text class="list-kicker">为你筛选</text>
            <text class="list-title">附近停车场</text>
          </view>
          <text class="list-count">{{recommendations.length}} 个结果</text>
        </view>

        <block wx:if="{{hasRecommendations}}">
          <view wx:for="{{visibleRecommendations}}" wx:key="id" class="lot-card {{item.bestClass}}">
            <view class="lot-main">
              <view class="rank-badge">{{item.rank}}</view>
              <view class="lot-info">
                <view class="lot-title-line">
                  <text class="lot-name">{{item.name}}</text>
                  <text wx:if="{{item.isBest}}" class="best-label">推荐</text>
                </view>
                <text class="lot-address">{{item.address}}</text>
              </view>
              <view class="price-box">
                <text class="price">{{item.feeText}}</text>
                <text class="price-note">预计费用</text>
              </view>
            </view>

            <view class="metric-row">
              <text class="metric-item">{{item.parkingTypeText}}</text>
              <text class="metric-item">距目的地 {{item.distanceText}}</text>
              <text class="metric-item">步行 {{item.walkingMinutes}} 分钟</text>
            </view>

            <view class="tag-row">
              <text wx:for="{{item.tags}}" wx:key="*this" class="pill">{{item}}</text>
            </view>

            <view class="source-line">
              <view class="source-avatar" style="background: {{item.owner.avatarColor}}">
                <image wx:if="{{item.owner.avatarUrl}}" class="source-avatar-image" src="{{item.owner.avatarUrl}}" mode="aspectFill" />
                <text wx:else>{{item.owner.avatarText}}</text>
              </view>
              <text class="source-name">{{item.owner.nickname}}</text>
              <text class="source-confidence">可信度 {{item.confidence}}</text>
            </view>

            <view class="action-row">
              <button class="ghost-button action-button" data-id="{{item.id}}" bindtap="goDetail">查看详情</button>
              <button class="primary-button action-button" data-id="{{item.id}}" bindtap="openNavigation">去这里</button>
            </view>
          </view>
          <view class="load-more-line {{hasMoreRecommendations ? '' : 'is-end'}}">{{hasMoreRecommendations ? '继续下拉加载更多' : '已经看完全部推荐'}}</view>
        </block>

        <view wx:else class="empty sheet-empty">{{emptyText}}</view>
      </view>
    </scroll-view>
  </view>
</view>
