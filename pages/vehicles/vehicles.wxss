.vehicles-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #f2f4f3;
}

.is-pressed {
  opacity: 0.75;
}

.vehicles-header {
  display: flex;
  flex-direction: column;
  padding: 12rpx 8rpx 28rpx;
}

.vehicles-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #17201e;
}

.vehicles-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #74807c;
}

/* 登录引导 */
.login-panel,
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx;
  border-radius: 32rpx;
  background: #ffffff;
  text-align: center;
}

.login-illustration {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e2f2ec;
}

.login-car {
  font-size: 56rpx;
}

.login-title,
.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #17201e;
}

.login-copy,
.empty-copy {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #74807c;
}

.login-button {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1a7f64;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
}

/* 车辆卡片 */
.vehicle-card {
  position: relative;
  margin-bottom: 18rpx;
  padding: 28rpx 24rpx;
  border: 3rpx solid transparent;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(23, 32, 30, 0.04);
}

.vehicle-card.is-current {
  border-color: #1a7f64;
}

.vehicle-card-main {
  display: flex;
  align-items: center;
  padding-right: 64rpx;
}

.plate-badge {
  flex-shrink: 0;
  min-width: 260rpx;
  height: 76rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  box-shadow: 0 0 0 2rpx #1d4fa3;
  background: #1d4fa3;
}

.plate-badge.is-new-energy {
  box-shadow: 0 0 0 2rpx #3aa66b;
  background: linear-gradient(180deg, #f4fbf6 0%, #7fd3a0 100%);
}

.plate-number {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #ffffff;
  white-space: nowrap;
}

.plate-badge.is-new-energy .plate-number {
  color: #17201e;
}

.vehicle-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.vehicle-type-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #17201e;
}

.vehicle-state {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8a9692;
}

.vehicle-card.is-current .vehicle-state {
  color: #1a7f64;
  font-weight: 600;
}

.vehicle-radio {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #c9d2ce;
  border-radius: 50%;
  box-sizing: border-box;
}

.vehicle-radio.is-on {
  border: 12rpx solid #1a7f64;
}

.vehicle-more {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a9692;
  font-size: 30rpx;
  font-weight: 700;
}

.add-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(242, 244, 243, 0) 0%, #f2f4f3 30%);
}

.add-button {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1a7f64;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(26, 127, 100, 0.24);
}

/* 车牌录入面板 */
.sheet-kicker {
  display: block;
  color: #1a7f64;
  font-size: 22rpx;
  font-weight: 700;
}

.sheet-title {
  display: block;
}

.plate-sheet-header {
  display: flex;
  align-items: center;
}

.plate-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 31, 28, 0.48);
}

.plate-sheet {
  width: 100%;
  max-height: 92vh;
  padding: 30rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);
  overflow-y: auto;
  border-radius: 38rpx 38rpx 0 0;
  background: #f2f4f3;
}

.plate-sheet-header {
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 6rpx;
}

.sheet-title {
  margin-top: 5rpx;
  color: #17201e;
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #65716d;
  background: #e7ebe8;
  font-size: 32rpx;
}

.plate-preview-card {
  margin-top: 24rpx;
  padding: 28rpx 22rpx 22rpx;
  border: 1rpx solid #dce5e0;
  border-radius: 26rpx;
  background: #ffffff;
}

.plate-slots {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 7rpx;
}

.plate-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 0.78;
  min-width: 0;
  border: 2rpx solid #dce3df;
  border-radius: 10rpx;
  color: #24312d;
  background: #f1f4f1;
  font-size: 29rpx;
  font-weight: 900;
}

.plate-slot.is-filled {
  color: #ffffff;
  border-color: #1a7f64;
  background: #1a7f64;
}

.plate-slot.is-active {
  border-color: #d49a6a;
  box-shadow: 0 0 0 4rpx rgba(212, 154, 106, 0.12);
}

.plate-slot.is-energy-slot:not(.is-filled) {
  border-color: #9ecabd;
  background: #edf7f3;
}

.plate-meta-row {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
  color: #77837f;
  font-size: 20rpx;
}

.plate-benefit-row,
.auto-type-row {
  gap: 7rpx;
}

.benefit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #1a7f64;
  font-size: 18rpx;
  font-weight: 900;
}

.auto-type-value {
  color: #1a7f64;
  font-weight: 900;
}

.keyboard-panel {
  margin-top: 18rpx;
  padding: 14rpx 10rpx 16rpx;
  border-radius: 24rpx;
  background: #dfe4e1;
}

.keyboard-row {
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  gap: 7rpx;
  margin-top: 9rpx;
}

.keyboard-row:first-child {
  margin-top: 0;
}

.keyboard-key {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 10rpx;
  color: #1e2926;
  background: #ffffff;
  box-shadow: 0 3rpx 0 rgba(31, 47, 43, 0.08);
  font-size: 28rpx;
  font-weight: 800;
}

.keyboard-key.is-delete {
  grid-column: span 2;
  background: #c4ccc7;
  font-size: 22rpx;
}

.confirm-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 82rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #1a7f64;
  box-shadow: 0 10rpx 24rpx rgba(23, 107, 91, 0.18);
  font-size: 28rpx;
  font-weight: 900;
}
