.vehicles-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 52rpx);
  background: #f6f7f4;
}

.vehicles-header,
.current-card-top,
.list-heading,
.vehicle-card-head,
.vehicle-actions,
.plate-sheet-header,
.plate-meta-row,
.plate-benefit-row,
.auto-type-row {
  display: flex;
  align-items: center;
}

.vehicles-header {
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 4rpx 10rpx;
}

.vehicles-header > view:first-child {
  flex: 1;
  min-width: 0;
}

.vehicles-kicker,
.vehicles-title,
.vehicles-subtitle,
.login-title,
.login-copy,
.current-label,
.current-value,
.current-copy,
.list-kicker,
.list-title,
.plate-number,
.vehicle-type-text,
.sheet-kicker,
.sheet-title {
  display: block;
}

.vehicles-kicker,
.list-kicker,
.sheet-kicker {
  color: #176b5b;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.vehicles-title {
  margin-top: 6rpx;
  color: #17201e;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.vehicles-subtitle {
  margin-top: 8rpx;
  color: #7b8783;
  font-size: 22rpx;
}

.vehicle-count-pill {
  flex: 0 0 auto;
  padding: 11rpx 16rpx;
  border-radius: 999rpx;
  color: #176b5b;
  background: #e2f1eb;
  font-size: 21rpx;
  font-weight: 900;
}

.login-panel {
  margin-top: 32rpx;
  padding: 42rpx 32rpx 34rpx;
  border: 1rpx solid #e0e6e2;
  border-radius: 30rpx;
  background: #ffffff;
  text-align: center;
}

.login-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 34rpx;
  background: #e2f1eb;
  transform: rotate(-5deg);
}

.login-car {
  color: #176b5b;
  font-size: 36rpx;
  font-weight: 900;
  transform: rotate(5deg);
}

.login-title {
  margin-top: 26rpx;
  color: #17201e;
  font-size: 32rpx;
  font-weight: 900;
}

.login-copy {
  max-width: 540rpx;
  margin: 12rpx auto 0;
  color: #798581;
  font-size: 24rpx;
  line-height: 1.55;
}

.login-button {
  width: 100%;
  margin-top: 28rpx;
  border-radius: 20rpx;
}

.current-card {
  position: relative;
  margin-top: 26rpx;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #183f36, #176b5b);
  box-shadow: 0 16rpx 40rpx rgba(23, 73, 62, 0.18);
}

.current-card::after {
  content: "";
  position: absolute;
  right: -60rpx;
  bottom: -120rpx;
  width: 280rpx;
  height: 280rpx;
  border: 38rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.current-card-top {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 18rpx;
}

.current-card-top > view:first-child {
  flex: 1;
  min-width: 0;
}

.current-label {
  color: rgba(255, 255, 255, 0.65);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.current-value {
  margin-top: 9rpx;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #176b5b;
  background: #bce9d7;
  font-size: 27rpx;
  font-weight: 900;
}

.current-copy {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.list-section {
  margin-top: 34rpx;
}

.list-heading {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.list-heading > view {
  flex: 1;
  min-width: 0;
}

.list-title {
  margin-top: 5rpx;
  color: #65716d;
  font-size: 22rpx;
}

.add-entry-button {
  flex: 0 0 190rpx;
  width: 190rpx;
  min-height: 66rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
}

.vehicle-card {
  position: relative;
  margin-top: 16rpx;
  padding: 26rpx;
  overflow: hidden;
  border: 1rpx solid #e0e6e2;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 47, 43, 0.04);
}

.vehicle-card::after {
  content: "";
  position: absolute;
  right: -30rpx;
  top: -45rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(23, 107, 91, 0.05);
}

.vehicle-card.is-current {
  border-color: #92c4b6;
  background: #fbfefd;
  box-shadow: 0 10rpx 28rpx rgba(23, 107, 91, 0.09);
}

.vehicle-card-main,
.vehicle-actions {
  position: relative;
  z-index: 1;
}

.vehicle-card-head {
  justify-content: space-between;
  gap: 16rpx;
}

.vehicle-card-head > view {
  flex: 1;
  min-width: 0;
}

.plate-number {
  color: #17201e;
  font-size: 39rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.vehicle-type-text {
  margin-top: 7rpx;
  color: #7a8682;
  font-size: 21rpx;
}

.current-badge,
.edit-hint {
  flex: 0 0 auto;
  font-size: 21rpx;
  font-weight: 800;
}

.current-badge {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #176b5b;
  background: #e2f1eb;
}

.edit-hint {
  color: #81908b;
}

.vehicle-actions {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0ed;
}

.small-button {
  flex: 1;
  min-width: 0;
  min-height: 58rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.delete-button {
  color: #8d5b48;
  background: #f4ece8;
}

.current-action-note {
  flex: 1;
  color: #176b5b;
  font-size: 21rpx;
  font-weight: 800;
}

.plate-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 31, 28, 0.48);
}

.plate-sheet {
  width: 100%;
  max-height: 92vh;
  padding: 30rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);
  overflow-y: auto;
  border-radius: 38rpx 38rpx 0 0;
  background: #f6f7f4;
}

.plate-sheet-header {
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 6rpx;
}

.sheet-title {
  margin-top: 5rpx;
  color: #17201e;
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #65716d;
  background: #e7ebe8;
  font-size: 32rpx;
}

.plate-preview-card {
  margin-top: 24rpx;
  padding: 28rpx 22rpx 22rpx;
  border: 1rpx solid #dce5e0;
  border-radius: 26rpx;
  background: #ffffff;
}

.plate-slots {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 7rpx;
}

.plate-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 0.78;
  min-width: 0;
  border: 2rpx solid #dce3df;
  border-radius: 10rpx;
  color: #24312d;
  background: #f1f4f1;
  font-size: 29rpx;
  font-weight: 900;
}

.plate-slot.is-filled {
  color: #ffffff;
  border-color: #176b5b;
  background: #176b5b;
}

.plate-slot.is-active {
  border-color: #d49a6a;
  box-shadow: 0 0 0 4rpx rgba(212, 154, 106, 0.12);
}

.plate-slot.is-energy-slot:not(.is-filled) {
  border-color: #9ecabd;
  background: #edf7f3;
}

.plate-meta-row {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
  color: #77837f;
  font-size: 20rpx;
}

.plate-benefit-row,
.auto-type-row {
  gap: 7rpx;
}

.benefit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #176b5b;
  font-size: 18rpx;
  font-weight: 900;
}

.auto-type-value {
  color: #176b5b;
  font-weight: 900;
}

.keyboard-panel {
  margin-top: 18rpx;
  padding: 14rpx 10rpx 16rpx;
  border-radius: 24rpx;
  background: #dfe4e1;
}

.keyboard-row {
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  gap: 7rpx;
  margin-top: 9rpx;
}

.keyboard-row:first-child {
  margin-top: 0;
}

.keyboard-key {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 10rpx;
  color: #1e2926;
  background: #ffffff;
  box-shadow: 0 3rpx 0 rgba(31, 47, 43, 0.08);
  font-size: 28rpx;
  font-weight: 800;
}

.keyboard-key.is-delete {
  grid-column: span 2;
  background: #c4ccc7;
  font-size: 22rpx;
}

.confirm-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 82rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #176b5b;
  box-shadow: 0 10rpx 24rpx rgba(23, 107, 91, 0.18);
  font-size: 28rpx;
  font-weight: 900;
}
