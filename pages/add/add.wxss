.add-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #f2f4f3;
}

.is-pressed {
  opacity: 0.75;
}

.intro {
  display: flex;
  flex-direction: column;
  padding: 12rpx 8rpx 28rpx;
}

.intro-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #17201e;
}

.intro-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #74807c;
}

/* 登录 */
.login-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx;
  border-radius: 32rpx;
  background: #ffffff;
  text-align: center;
}

.login-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201e;
}

.login-copy {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #74807c;
}

.login-button {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1a7f64;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
}

/* 步骤卡片 */
.form-step {
  margin-bottom: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.step-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.step-number {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1a7f64;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.step-title {
  flex: 1;
  font-size: 31rpx;
  font-weight: 700;
  color: #17201e;
}

.step-optional {
  font-size: 22rpx;
  color: #9aa5a1;
}

.step-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8a9692;
}

.warning-text {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff1e6;
  color: #b4521c;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 照片 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.photo-thumb {
  width: 100%;
  height: 100%;
  background: #eef2f0;
}

.remove-photo {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(23, 32, 30, 0.6);
  color: #ffffff;
  font-size: 30rpx;
}

.photo-upload-status {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 0;
  background: rgba(180, 82, 28, 0.85);
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #b5c4bf;
  background: #f7f9f8;
  box-sizing: border-box;
}

.photo-add-icon {
  font-size: 48rpx;
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #5d6b67;
}

.recognize-button {
  margin-top: 22rpx;
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #e2f2ec;
  color: #1a7f64;
  font-size: 27rpx;
  font-weight: 700;
}

.recognize-button[disabled] {
  background: #eef2f0 !important;
  color: #9aa5a1 !important;
}

/* 位置 */
.location-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx dashed #b5c4bf;
  border-radius: 20rpx;
  background: #f7f9f8;
}

.location-card.is-set {
  border: 2rpx solid #bfe3d5;
  background: #eef8f4;
}

.location-pin {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.location-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.location-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #17201e;
}

.location-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #74807c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.location-action {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #1a7f64;
}

.location-links {
  display: flex;
  justify-content: space-between;
  margin: 16rpx 4rpx 4rpx;
}

.text-link {
  font-size: 24rpx;
  color: #1a7f64;
}

.text-link.is-muted {
  color: #8a9692;
}

/* 表单字段 */
.field {
  margin-top: 20rpx;
  min-width: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #5d6b67;
}

.field-optional {
  margin-left: 6rpx;
  font-size: 21rpx;
  color: #a3ada9;
}

.field-input,
.picker-value {
  height: 84rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  background: #f2f5f4;
  font-size: 28rpx;
  color: #17201e;
}

.picker-value {
  justify-content: space-between;
}

.picker-caret {
  color: #8a9692;
  font-size: 22rpx;
}

.field-textarea {
  width: 100%;
  height: 160rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f2f5f4;
  font-size: 27rpx;
  box-sizing: border-box;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 18rpx;
}

.three-column {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  column-gap: 14rpx;
}

/* 收费类型 */
.charge-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #eef2f0;
}

.charge-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #5d6b67;
  font-size: 26rpx;
}

.charge-tab.is-active {
  background: #ffffff;
  color: #17201e;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 30, 0.08);
}

.ladder-row {
  margin-top: 20rpx;
  padding: 4rpx 20rpx 20rpx;
  border-radius: 18rpx;
  background: #f7f9f8;
}

.ladder-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.ladder-row-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #3c4a46;
}

.ladder-remove {
  font-size: 24rpx;
  color: #b4521c;
}

.ladder-row .field-input {
  background: #ffffff;
}

.add-ladder-button {
  margin-top: 18rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #b5c4bf;
  border-radius: 16rpx;
  color: #1a7f64;
  font-size: 25rpx;
  font-weight: 600;
}

/* 费用预览 */
.price-preview {
  margin-top: 26rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #fff7f1;
}

.preview-title {
  display: block;
  font-size: 23rpx;
  color: #9a6a4e;
}

.preview-row {
  display: flex;
  margin-top: 14rpx;
}

.preview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-fee {
  font-size: 30rpx;
  font-weight: 800;
  color: #e2561f;
}

.preview-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa5a1;
}

/* 开关 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.energy-row {
  padding-top: 24rpx;
  border-top: 1rpx solid #edf1ef;
}

.switch-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.switch-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #17201e;
}

.switch-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa5a1;
}

.energy-fields {
  margin-top: 4rpx;
}

/* 更多 */
.more-step {
  padding-top: 26rpx;
  padding-bottom: 26rpx;
}

.more-toggle {
  display: flex;
  align-items: baseline;
}

.more-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #17201e;
}

.more-sub {
  flex: 1;
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #9aa5a1;
}

.more-caret {
  font-size: 24rpx;
  color: #1a7f64;
}

/* 提交 */
.submit-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(23, 32, 30, 0.06);
}

.save-button {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1a7f64;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}
