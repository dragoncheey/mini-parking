<view class="add-page">
  <view class="intro">
    <text class="intro-title">{{pageTitle}}</text>
    <text class="intro-text">{{introText}}</text>
  </view>

  <view wx:if="{{loginRequired}}" class="login-panel">
    <text class="login-title">登录后才能分享</text>
    <text class="login-copy">分享的停车场会显示你的头像作为来源，之后也只有你能修改。</text>
    <button class="login-button" bindtap="goProfile">前往“我的”登录</button>
  </view>

  <block wx:else>
    <!-- 1 拍照识别 -->
    <view class="form-step">
      <view class="step-head">
        <text class="step-number">1</text>
        <text class="step-title">拍收费牌，自动填写</text>
        <text class="step-optional">可跳过</text>
      </view>

      <view class="photo-grid">
        <view wx:for="{{evidencePhotos}}" wx:key="path" class="photo-item">
          <image class="photo-thumb" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewEvidence" />
          <view class="remove-photo" data-index="{{index}}" catchtap="removeEvidence">×</view>
          <view wx:if="{{item.uploadError}}" class="photo-upload-status">未上传</view>
        </view>
        <view class="photo-add" bindtap="captureEvidence" hover-class="is-pressed">
          <text class="photo-add-icon">📷</text>
          <text class="photo-add-text">{{photoCount ? '再拍一张' : '拍照/相册'}}</text>
        </view>
      </view>

      <button
        wx:if="{{photoCount}}"
        class="recognize-button"
        disabled="{{recognizeDisabled}}"
        loading="{{isRecognizing}}"
        bindtap="recognizeEvidence"
      >✨ 识别照片并自动填写</button>
      <text class="step-hint">{{photoCount ? recognitionStatus + ' · ' + recognitionHint : '拍收费牌最有用，入口照片能帮别人找到位置。'}}</text>
      <text wx:if="{{recognitionWarningText}}" class="warning-text">⚠️ {{recognitionWarningText}}</text>
    </view>

    <!-- 2 位置 -->
    <view class="form-step">
      <view class="step-head">
        <text class="step-number">2</text>
        <text class="step-title">停车场在哪</text>
      </view>

      <view class="location-card {{form.latitude && form.longitude ? 'is-set' : ''}}" bindtap="chooseParkingLocation" hover-class="is-pressed">
        <text class="location-pin">📍</text>
        <view class="location-copy">
          <text class="location-title">{{form.latitude && form.longitude ? '已选位置' : '在地图上选择位置'}}</text>
          <text class="location-sub">{{form.latitude && form.longitude ? (form.address || form.latitude + ', ' + form.longitude) : '会自动填好名称和地址'}}</text>
        </view>
        <text class="location-action">{{form.latitude && form.longitude ? '修改' : '选择'}} ›</text>
      </view>
      <view class="location-links">
        <text class="text-link" bindtap="useCurrentLocation">我就在停车场，用当前位置</text>
        <text class="text-link is-muted" bindtap="toggleCoords">{{showCoords ? '收起坐标' : '手动填坐标'}}</text>
      </view>
      <view wx:if="{{showCoords}}" class="two-column">
        <view class="field">
          <text class="field-label">纬度</text>
          <input class="field-input" type="digit" value="{{form.latitude}}" data-key="latitude" bindinput="onInput" placeholder="31.23041" />
        </view>
        <view class="field">
          <text class="field-label">经度</text>
          <input class="field-input" type="digit" value="{{form.longitude}}" data-key="longitude" bindinput="onInput" placeholder="121.47370" />
        </view>
      </view>

      <view class="field">
        <text class="field-label">名称</text>
        <input class="field-input" value="{{form.name}}" data-key="name" bindinput="onInput" placeholder="例如：星河广场地下停车场" />
      </view>
      <view class="field">
        <text class="field-label">地址</text>
        <input class="field-input" value="{{form.address}}" data-key="address" bindinput="onInput" placeholder="停车场入口或详细地址" />
      </view>
      <view class="field">
        <text class="field-label">怎么进 <text class="field-optional">选填</text></text>
        <input class="field-input" value="{{form.entrance}}" data-key="entrance" bindinput="onInput" placeholder="例如：商场东门旁下坡入口" />
      </view>
    </view>

    <!-- 3 收费 -->
    <view class="form-step">
      <view class="step-head">
        <text class="step-number">3</text>
        <text class="step-title">怎么收费</text>
      </view>

      <view class="charge-tabs">
        <view
          wx:for="{{chargeTypeOptions}}"
          wx:key="value"
          class="charge-tab {{index === chargeTypeIndex ? 'is-active' : ''}}"
          data-index="{{index}}"
          bindtap="selectChargeType"
        >{{item.label}}</view>
      </view>
      <text class="step-hint">{{chargeTypeHint}}</text>

      <view class="two-column">
        <view class="field">
          <text class="field-label">免费时长（分钟）</text>
          <input class="field-input" type="number" value="{{form.freeMinutes}}" data-key="freeMinutes" bindinput="onInput" placeholder="0" />
        </view>
        <view class="field">
          <text class="field-label">每天封顶（元）<text class="field-optional">选填</text></text>
          <input class="field-input" type="digit" value="{{form.maxDailyPrice}}" data-key="maxDailyPrice" bindinput="onInput" placeholder="不封顶" />
        </view>
      </view>

      <view wx:if="{{isFlatChargeType}}">
        <view class="two-column">
          <view class="field">
            <text class="field-label">每次时长（分钟）</text>
            <input class="field-input" type="number" value="{{form.flatDurationMinutes}}" data-key="flatDurationMinutes" bindinput="onInput" placeholder="1440" />
          </view>
          <view class="field">
            <text class="field-label">每次价格（元）</text>
            <input class="field-input" type="digit" value="{{form.flatPrice}}" data-key="flatPrice" bindinput="onInput" placeholder="例如 20" />
          </view>
        </view>
        <view class="switch-row">
          <view class="switch-copy">
            <text class="switch-title">超时后再收一次</text>
            <text class="switch-hint">关闭表示不管停多久只收一次</text>
          </view>
          <switch checked="{{form.flatRepeat}}" data-key="flatRepeat" bindchange="onSwitchChange" color="#1a7f64" />
        </view>
      </view>

      <view wx:elif="{{isLadderChargeType}}" class="ladder-list">
        <view wx:for="{{form.ladderRows}}" wx:key="id" class="ladder-row">
          <view class="ladder-row-head">
            <text class="ladder-row-title">第 {{index + 1}} 段</text>
            <text class="ladder-remove" data-index="{{index}}" bindtap="removeLadderRow">删除</text>
          </view>
          <view class="three-column">
            <view class="field">
              <text class="field-label">停到第几分钟</text>
              <input class="field-input" type="number" value="{{item.untilMinutes}}" data-index="{{index}}" data-key="untilMinutes" bindinput="onLadderInput" placeholder="空=之后" />
            </view>
            <view class="field">
              <text class="field-label">每(分钟)</text>
              <input class="field-input" type="number" value="{{item.billingUnitMinutes}}" data-index="{{index}}" data-key="billingUnitMinutes" bindinput="onLadderInput" placeholder="60" />
            </view>
            <view class="field">
              <text class="field-label">收(元)</text>
              <input class="field-input" type="digit" value="{{item.unitPrice}}" data-index="{{index}}" data-key="unitPrice" bindinput="onLadderInput" placeholder="5" />
            </view>
          </view>
        </view>
        <view class="add-ladder-button" bindtap="addLadderRow">＋ 再加一段</view>
      </view>

      <view wx:else class="two-column">
        <view class="field">
          <text class="field-label">每（分钟）</text>
          <input class="field-input" type="number" value="{{form.billingUnitMinutes}}" data-key="billingUnitMinutes" bindinput="onInput" placeholder="60" />
        </view>
        <view class="field">
          <text class="field-label">收（元）</text>
          <input class="field-input" type="digit" value="{{form.unitPrice}}" data-key="unitPrice" bindinput="onInput" placeholder="例如 5" />
        </view>
      </view>

      <view class="price-preview">
        <text class="preview-title">按这个规则，大概要付</text>
        <view class="preview-row">
          <view wx:for="{{pricePreview}}" wx:key="label" class="preview-item">
            <text class="preview-fee">{{item.feeText}}</text>
            <text class="preview-label">停{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="switch-row energy-row">
        <view class="switch-copy">
          <text class="switch-title">新能源车有优惠</text>
          <text class="switch-hint">只填和上面不一样的，空着就按上面的规则</text>
        </view>
        <switch checked="{{form.newEnergyEnabled}}" data-key="newEnergyEnabled" bindchange="onSwitchChange" color="#1a7f64" />
      </view>
      <view wx:if="{{form.newEnergyEnabled}}" class="energy-fields">
        <view class="two-column">
          <view class="field">
            <text class="field-label">免费时长（分钟）</text>
            <input class="field-input" type="number" value="{{form.newEnergyFreeMinutes}}" data-key="newEnergyFreeMinutes" bindinput="onInput" placeholder="120" />
          </view>
          <view class="field">
            <text class="field-label">每天封顶（元）</text>
            <input class="field-input" type="digit" value="{{form.newEnergyMaxDailyPrice}}" data-key="newEnergyMaxDailyPrice" bindinput="onInput" placeholder="同上" />
          </view>
          <view class="field" wx:if="{{!isFlatChargeType}}">
            <text class="field-label">每（分钟）</text>
            <input class="field-input" type="number" value="{{form.newEnergyBillingUnitMinutes}}" data-key="newEnergyBillingUnitMinutes" bindinput="onInput" placeholder="同上" />
          </view>
          <view class="field" wx:if="{{!isFlatChargeType}}">
            <text class="field-label">收（元）</text>
            <input class="field-input" type="digit" value="{{form.newEnergyUnitPrice}}" data-key="newEnergyUnitPrice" bindinput="onInput" placeholder="同上" />
          </view>
          <view class="field" wx:if="{{isFlatChargeType}}">
            <text class="field-label">每次时长（分钟）</text>
            <input class="field-input" type="number" value="{{form.newEnergyFlatDurationMinutes}}" data-key="newEnergyFlatDurationMinutes" bindinput="onInput" placeholder="同上" />
          </view>
          <view class="field" wx:if="{{isFlatChargeType}}">
            <text class="field-label">每次价格（元）</text>
            <input class="field-input" type="digit" value="{{form.newEnergyFlatPrice}}" data-key="newEnergyFlatPrice" bindinput="onInput" placeholder="同上" />
          </view>
        </view>
        <view class="field">
          <text class="field-label">新能源说明 <text class="field-optional">选填</text></text>
          <input class="field-input" value="{{form.newEnergyNotes}}" data-key="newEnergyNotes" bindinput="onInput" placeholder="例如：新能源 2 小时免费" />
        </view>
      </view>
    </view>

    <!-- 更多 -->
    <view class="form-step more-step">
      <view class="more-toggle" bindtap="toggleMore">
        <text class="more-title">更多信息</text>
        <text class="more-sub">车位情况、最低收费、备注等</text>
        <text class="more-caret">{{showMore ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{showMore}}">
        <view class="field">
          <text class="field-label">车位情况</text>
          <picker mode="selector" range="{{availabilityOptions}}" range-key="label" value="{{availabilityIndex}}" bindchange="onAvailabilityChange">
            <view class="picker-value">{{availabilityLabel}} <text class="picker-caret">▾</text></view>
          </picker>
        </view>
        <view class="two-column">
          <view class="field">
            <text class="field-label">最低收费（元）</text>
            <input class="field-input" type="digit" value="{{form.minCharge}}" data-key="minCharge" bindinput="onInput" placeholder="无" />
          </view>
          <view class="field">
            <text class="field-label">出来还要走（分钟）</text>
            <input class="field-input" type="number" value="{{form.walkingPenaltyMinutes}}" data-key="walkingPenaltyMinutes" bindinput="onInput" placeholder="0" />
          </view>
        </view>
        <view class="field">
          <text class="field-label">收费备注</text>
          <textarea class="field-textarea" value="{{form.notes}}" data-key="notes" bindinput="onInput" placeholder="例如：夜间 20:00 后每次 10 元" />
        </view>
      </block>
    </view>

    <view class="submit-dock">
      <button class="save-button" loading="{{loading}}" bindtap="save">{{saveButtonText}}</button>
    </view>
  </block>
</view>
