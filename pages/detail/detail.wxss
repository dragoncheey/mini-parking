.detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #f2f4f3;
}

.is-pressed {
  opacity: 0.75;
}

.detail-hero {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 8rpx 24rpx;
}

.detail-hero-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.detail-title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #17201e;
}

.detail-address {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #74807c;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.detail-tag {
  height: 42rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 10rpx;
  background: #e2f2ec;
  color: #1a7f64;
  font-size: 22rpx;
}

.detail-tag.is-warn {
  background: #fff1e6;
  color: #b4521c;
}

.edit-button {
  flex-shrink: 0;
  margin-left: 20rpx;
  height: 60rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3c4a46;
  font-size: 25rpx;
  font-weight: 600;
}

.detail-primary-panel {
  padding: 32rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(23, 32, 30, 0.06);
  display: flex;
  flex-direction: column;
}

.fee-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  color: #74807c;
}

.fee-vehicle {
  max-width: 55%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fee-value {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: #e2561f;
  line-height: 1.2;
}

.fee-value.is-free {
  color: #1a7f64;
}

.fee-reason {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #5d6b67;
}

.stat-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf1ef;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid #edf1ef;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201e;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa5a1;
}

.section {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.section-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201e;
}

.section-side {
  font-size: 23rpx;
  color: #9aa5a1;
}

.body-text {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #3c4a46;
}

.body-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a9692;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.photo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #eef2f0;
}

.owner-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.owner-avatar {
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  background: #1a7f64;
}

.owner-avatar-image {
  width: 100%;
  height: 100%;
}

.owner-info {
  display: flex;
  flex-direction: column;
}

.owner-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #17201e;
}

.owner-label {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8a9692;
}

.vote-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.vote-button {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e2e8e5;
  border-radius: 20rpx;
  color: #3c4a46;
  font-size: 26rpx;
  font-weight: 600;
}

.vote-button.is-up.is-active {
  border-color: #1a7f64;
  background: #e2f2ec;
  color: #1a7f64;
}

.vote-button.is-down.is-active {
  border-color: #e2561f;
  background: #fff1e6;
  color: #b4521c;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(23, 32, 30, 0.06);
}

.bar-button {
  width: 120rpx;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #4b5a56;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.3;
  background: transparent;
}

.bar-share {
  padding: 0;
  margin: 0;
}

.bar-icon {
  font-size: 34rpx;
  line-height: 1.2;
}

.nav-primary {
  flex: 1;
  height: 92rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1a7f64;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(26, 127, 100, 0.24);
}

.detail-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a9692;
}
