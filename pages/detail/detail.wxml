<view class="detail-page">
  <block wx:if="{{lot}}">
    <view class="detail-hero">
      <view class="detail-hero-main">
        <text class="detail-title">{{lot.name}}</text>
        <text class="detail-address">{{lot.address}}</text>
        <view wx:if="{{detail.tags.length}}" class="tag-row">
          <text
            wx:for="{{detail.tags}}"
            wx:key="*this"
            class="detail-tag {{item === '建议复核' ? 'is-warn' : ''}}"
          >{{item}}</text>
        </view>
      </view>
      <view wx:if="{{lot.canEdit}}" class="edit-button" bindtap="goEdit">编辑</view>
    </view>

    <view class="detail-primary-panel">
      <view class="fee-head">
        <text class="fee-label">停 {{detail.durationText}} 预计</text>
        <text class="fee-vehicle">{{currentVehicle ? currentVehicleText : '默认计费'}}</text>
      </view>
      <text class="fee-value {{detail.fee === 0 ? 'is-free' : ''}}">{{detail.feeText}}</text>
      <text class="fee-reason">{{detail.reason}}</text>
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-value">{{detail.distanceText}}</text>
          <text class="stat-label">距目的地</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{detail.walkingMinutes}} 分钟</text>
          <text class="stat-label">步行</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{lot.confidence}}</text>
          <text class="stat-label">可信度</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">收费规则</text>
      <text class="body-text">{{detail.pricingText}}</text>
      <text wx:if="{{lot.pricing.maxDailyPrice}}" class="body-hint">单日封顶 {{lot.pricing.maxDailyPrice}} 元</text>
    </view>

    <view class="section">
      <text class="section-title">怎么进</text>
      <text class="body-text">{{lot.access.entrance || '暂无入口说明'}}</text>
    </view>

    <view class="section">
      <view class="section-heading-row">
        <text class="section-title">现场图片</text>
        <text class="section-side">{{evidenceStatus}}</text>
      </view>
      <view wx:if="{{evidencePhotoCount}}" class="photo-grid">
        <image
          wx:for="{{evidencePhotos}}"
          wx:key="path"
          class="photo-thumb"
          src="{{item.path}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewEvidence"
        />
      </view>
      <text wx:else class="body-hint">暂未上传图片。</text>
    </view>

    <view class="section trust-section">
      <view class="section-heading-row">
        <text class="section-title">信息靠谱吗</text>
        <text class="section-side">赞 {{voteUp}} · 踩 {{voteDown}}</text>
      </view>
      <view class="owner-row">
        <view class="owner-avatar" style="background: {{lot.owner.avatarColor}}">
          <image wx:if="{{lot.owner.avatarUrl}}" class="owner-avatar-image" src="{{lot.owner.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{lot.owner.avatarText}}</text>
        </view>
        <view class="owner-info">
          <text class="owner-name">{{lot.owner.nickname}}</text>
          <text class="owner-label">{{sourceText}} · 基础可信度 {{lot.rawConfidence}}</text>
        </view>
      </view>
      <text wx:if="{{lot.confidenceResetAt}}" class="body-hint">最近维护后已重置信任，需要用户重新确认。</text>
      <view wx:if="{{canVote}}" class="vote-row">
        <view class="vote-button is-up {{upVoteClass}}" data-vote="up" bindtap="vote">👍 信息准确</view>
        <view class="vote-button is-down {{downVoteClass}}" data-vote="down" bindtap="vote">⚠️ 需要复核</view>
      </view>
      <text wx:elif="{{lot.canEdit}}" class="body-hint">这是你分享的停车场，其他用户会评价它的准确性。</text>
      <text wx:else class="body-hint">登录后可以评价这条信息，帮助大家排序更准。</text>
    </view>

    <view class="bottom-actions">
      <view class="bar-button" bindtap="copyLocation">
        <text class="bar-icon">⧉</text>
        <text>复制位置</text>
      </view>
      <button class="bar-button bar-share" open-type="share">
        <text class="bar-icon">↗</text>
        <text>分享</text>
      </button>
      <view class="nav-primary" bindtap="openNavigation" hover-class="is-pressed">导航去这里</view>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="detail-loading">加载中…</view>

  <view wx:else class="empty">
    没找到这个停车场，可能已被删除，或网络暂时不可用。
  </view>
</view>
